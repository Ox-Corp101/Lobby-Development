# Copy this file to .env.local and fill in the two values from your Supabase project.
# .env.local is ignored by Git. Never commit real values.
#
# Project URL: Supabase dashboard > Project Settings > API (Data API)
VITE_SUPABASE_URL=
# Publishable key (sb_publishable_...): Supabase dashboard > Project Settings > API Keys
# NEVER use a secret key (sb_secret_...) or the service_role key here.
VITE_SUPABASE_PUBLISHABLE_KEY=
